{
  "name": "sunshine-school-server",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "health": "node -e \"fetch('http://localhost:5000/api/system/v52/health').then(r=>r.text()).then(console.log).catch(e=>{console.error(e);process.exit(1)})\"",
    "production:check": "node -e \"if(process.env.NODE_ENV!=='production') console.log('Set NODE_ENV=production for the final check'); console.log('Production hardening checks available at /api/system/v52/health')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "sql.js": "^1.13.0"
  }
}
